# GitHub
GITHUB_TOKEN=ghp_xxx                     # PAT with repo scope, used to post PR comments
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# GCP
GCP_PROJECT_ID=code-kitchen-reviewer
GCP_REGION=asia-south1
FIRESTORE_COLLECTION=review_history
USE_CLOUD_TASKS=false
CLOUD_TASKS_QUEUE=review-jobs

# App
MAX_DIFF_CHARS=60000
PORT=8080
